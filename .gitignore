# Raw PDF source collection (large scans/books, CC-BY-NC-4.0 / non-redistributable,
# not meant to live on GitHub). Kept locally; see data/manifest.csv for the catalog.
/pdfs/

# Common Voice audio clips (large, CC0 but terms prohibit re-hosting/speaker ID).
# Publicly available directly from Mozilla Common Voice / Data Collective.
# Metadata (train/dev/validated .tsv etc.) stays tracked - only the audio itself
# is excluded. Path reflects the "datasets/" reorganization.
datasets/cv-corpus-*/**/clips/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env
*.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.cursor/

# Local Hugging Face staging (upload only; not source of truth)
data/ocr-gold-publish/
data/pdf-corpus-publish/

# Decode-table glyph crops (regenerable from PDFs)
data/decode/_glyph_crops/
data/decode/out/
data/decode/_tmp_*
data/decode/transfer_decode.log
data/decode/quran_gid_unknown.json

# Extracted Unicode from PDFs / local corpus copies (regenerable)
data/extracted/
