# Raw PDF source collection (large scans/books, CC-BY-NC-4.0 / non-redistributable,
# not meant to live on GitHub). Kept locally; see data/manifest.csv for the catalog.
/pdfs/

# Third-party datasets: kept locally, never re-hosted from this repo (see
# datasets/README.md). Common Voice terms prohibit re-hosting; the FLI corpus
# comes from Mozilla Data Collective under its own terms. Only the README is tracked.
datasets/cv-corpus-*/
datasets/Gojri Language Corpus/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env
*.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.cursor/

# Agent tooling (installed locally with `npx skills add`, not source)
.agents/

# Local Hugging Face staging (upload only; not source of truth)
data/ocr-gold-publish/
data/pdf-corpus-publish/
data/hf_upload/

# Decode-table glyph crops (regenerable from PDFs)
data/decode/_glyph_crops/
data/decode/out/
data/decode/_tmp_*
data/decode/transfer_decode.log
data/decode/quran_gid_unknown.json

# Synthetic OCR generation work area (fonts, renders, datasets); local only
# until the user approves a publish. Fonts are SIL OFL, datasets are ours.
data/synth/

# Extracted Unicode from PDFs / local corpus copies (regenerable)
data/extracted/

# Dictionary review tool output (book crops and marks; local only)
data/review/
data/release/

# OCR run outputs, book crops and fine-tune work folders (large; regenerable).
# The speaker's review labels from these runs are tracked in data/reviews/.
data/ocr/
data/utrnet-ft/
data/fli-review/

# ASR splits hold Common Voice sentence text (not re-hosted); the tracked data/asr/split_clips.tsv rebuilds them.
data/asr/splits/
data/asr/output/
data/test-locked/review.html

# OpenCode search output: third-party samples and private contact data
gojri-corpus-search/

# Third-party blog text fetched for research (see datasets/README.md)
datasets/gojri-blogs/
